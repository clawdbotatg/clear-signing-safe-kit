{
  "name": "clear-signing-safe-kit",
  "version": "0.4.0",
  "description": "What a Safe transaction does, in plain English: clear signing, swap words, danger rules, and clear-sim answers checked in the browser. Shared by Instant Wallet and wedgie.dev.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
