      "default": "./dist/index.js"
    },
    "./explain": {
      "types": "./dist/explain.d.ts",
      "default": "./dist/explain.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "node --test test/"
  },
  "peerDependencies": {
    "viem": "^2",
    "@ethereum-sourcify/clear-signing": "^0.2.2"
  },
  "peerDependenciesMeta": {
    "@ethereum-sourcify/clear-signing": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ethereum-sourcify/clear-signing": "^0.2.2",
    "typescript": "^5.9.3",
    "viem": "^2.57.2"
  },
  "dependencies": {
    "@adraffy/ens-normalize": "^1.11.1"
  }
